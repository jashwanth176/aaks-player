# Copy to keystore.properties (gitignored) and fill in; assembleRelease then signs the APK.
storeFile=release.keystore
storePassword=
keyAlias=aaks
# Leave blank if the key uses the store password
keyPassword=

# Optional bug report collector, baked into the APK. Without it reports are only saved on the headset.
#reportUrl=https://<your-collector>/report
#reportToken=
